-- =============================
-- AUTO FARM DOOM EVENT BUTTONS
-- =============================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local doomFarmEnabled = false
local doomFarmThread = nil
local doomNoclipConnection = nil

local FINAL_POSITION = Vector3.new(128.63, 3.26, 17.39)
local TARGET_Y = -2.74

local function stopDoomFarm()

    doomFarmEnabled = false

    if doomFarmThread then
        task.cancel(doomFarmThread)
        doomFarmThread = nil
    end

    if doomNoclipConnection then
        doomNoclipConnection:Disconnect()
        doomNoclipConnection = nil
    end

    if player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end
end

local function startDoomFarm()

    if doomFarmThread then return end

    doomFarmThread = task.spawn(function()

        while doomFarmEnabled do

            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local folder = workspace:FindFirstChild("DoomEventButtons")

            if not root or not folder then
                task.wait(1)
                continue
            end

            if not doomNoclipConnection then
                doomNoclipConnection = RunService.Stepped:Connect(function()
                    if player.Character then
                        for _, v in pairs(player.Character:GetDescendants()) do
                            if v:IsA("BasePart") then
                                v.CanCollide = false
                            end
                        end
                    end
                end)
            end

            local bv = Instance.new("BodyVelocity", root)
            bv.MaxForce = Vector3.new(1e9,1e9,1e9)

            local bp = Instance.new("BodyPosition", root)
            bp.MaxForce = Vector3.new(1e9,1e9,1e9)
            bp.P = 10000
            bp.D = 1000

            local function flyTo(pos)
                bp.Position = pos
                while doomFarmEnabled and (root.Position - pos).Magnitude > 3 do
                    local dir = (pos - root.Position).Unit
                    bv.Velocity = dir * 800
                    task.wait()
                end
                bv.Velocity = Vector3.zero
            end

            while doomFarmEnabled and #folder:GetChildren() > 0 do

                local nearest
                local shortest = math.huge

                for _, obj in pairs(folder:GetChildren()) do
                    local part = obj:IsA("Model") and obj:FindFirstChildWhichIsA("BasePart") or obj
                    if part and part:IsA("BasePart") then
                        local dist = (root.Position - part.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            nearest = part
                        end
                    end
                end

                if not nearest then break end

                flyTo(Vector3.new(root.Position.X, TARGET_Y, root.Position.Z))

                flyTo(Vector3.new(
                    nearest.Position.X,
                    nearest.Position.Y - 6,
                    nearest.Position.Z
                ))

                flyTo(nearest.Position)

                local prompt = nearest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    prompt.HoldDuration = 0
                    fireproximityprompt(prompt)
                end

                task.wait(0.5)
                flyTo(Vector3.new(root.Position.X, TARGET_Y, root.Position.Z))
                task.wait(0.2)
            end

            flyTo(FINAL_POSITION)

            bv:Destroy()
            bp:Destroy()

            task.wait(1)
        end

        stopDoomFarm()
    end)
end

