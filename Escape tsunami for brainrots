local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local brainrotsEnabled = false
local luckyEnabled = false

local farmThread = nil
local noclipConnection = nil

local TARGET_Y = -2.74
local FINAL_POSITION = Vector3.new(128.63,3.26,17.39)

local priorityTiers = {"Infinity", "Divine", "Celestial"}

-- =============================
-- STOP FUNCTION
-- =============================

local function stopFarm()
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

-- =============================
-- NOCLIP (chỉ khi có target)
-- =============================

local function startNoclip()

    if noclipConnection then return end

    noclipConnection = RunService.Stepped:Connect(function()

        if not (brainrotsEnabled or luckyEnabled) then
            noclipConnection:Disconnect()
            noclipConnection = nil
            return
        end

        if player.Character then
            for _, v in pairs(player.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
end

-- =============================
-- FLY FUNCTION
-- =============================

local function flyTo(root, hum, bv, bp, pos)

    bp.Position = pos

    while (brainrotsEnabled or luckyEnabled)
        and root
        and hum
        and hum.Health > 0
        and (root.Position - pos).Magnitude > 3 do

        local dist = (root.Position - pos).Magnitude
        local dir = (pos - root.Position).Unit
        local speed = dist < 40 and 300 or 1000

        bv.Velocity = dir * speed
        task.wait()
    end

    bv.Velocity = Vector3.zero
end

-- =============================
-- GET TARGET
-- =============================

local function getTarget(folder, root)

    if not folder or not root then return nil end

    for _, tierName in ipairs(priorityTiers) do
        local tier = folder:FindFirstChild(tierName)

        if tier and #tier:GetChildren() > 0 then

            local shortest = math.huge
            local nearest = nil

            for _, obj in pairs(tier:GetChildren()) do
                local part = obj:IsA("Model")
                    and obj:FindFirstChildWhichIsA("BasePart")
                    or obj

                if part and part:IsA("BasePart") then
                    local dist = (root.Position - part.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = part
                    end
                end
            end

            if nearest then
                return nearest
            end
        end
    end

    return nil
end

-- =============================
-- MAIN LOOP
-- =============================

local function startFarm()

    if farmThread then
        task.cancel(farmThread)
    end

    farmThread = task.spawn(function()

        while brainrotsEnabled or luckyEnabled do

            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if not char or not hum or hum.Health <= 0 or not root then
                task.wait(0.5)
                continue
            end

            local folder = nil

            -- PRIORITY 1: Brainrots
            if brainrotsEnabled then
                folder = workspace:FindFirstChild("ActiveBrainrots")
            end

            local target = getTarget(folder, root)

            -- PRIORITY 2: Lucky
            if not target and luckyEnabled then
                folder = workspace:FindFirstChild("ActiveLuckyBlocks")
                target = getTarget(folder, root)
            end

            if not target then
                task.wait(1)
                continue
            end

            startNoclip()

            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e9,1e9,1e9)
            bv.Parent = root

            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e9,1e9,1e9)
            bp.P = 10000
            bp.D = 1000
            bp.Parent = root

            local startPos = root.Position
            local startXZ = Vector3.new(startPos.X, TARGET_Y, startPos.Z)

            -- Xuống -2.74 trước
            flyTo(root, hum, bv, bp, startXZ)

            -- Nhặt tối đa 3 con
            for i = 1, 3 do

                if not (brainrotsEnabled or luckyEnabled) then break end
                if hum.Health <= 0 then break end

                local newTarget = nil

                if brainrotsEnabled then
                    local brainFolder = workspace:FindFirstChild("ActiveBrainrots")
                    newTarget = getTarget(brainFolder, root)
                end

                if not newTarget and luckyEnabled then
                    local luckyFolder = workspace:FindFirstChild("ActiveLuckyBlocks")
                    newTarget = getTarget(luckyFolder, root)
                end

                if not newTarget then break end

                local below = Vector3.new(
                    newTarget.Position.X,
                    newTarget.Position.Y - 6,
                    newTarget.Position.Z
                )

                flyTo(root, hum, bv, bp, below)
                flyTo(root, hum, bv, bp, newTarget.Position)

                local prompt = newTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    prompt.HoldDuration = 0
                    fireproximityprompt(prompt)
                end

                task.wait(0.5)

                -- quay lại -2.74 sau mỗi con
                flyTo(root, hum, bv, bp, startXZ)
            end

            -- Sau khi đủ 3 → về FINAL
            flyTo(root, hum, bv, bp, FINAL_POSITION)

            bv:Destroy()
            bp:Destroy()

            task.wait(0.3)
        end

        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end)
end

